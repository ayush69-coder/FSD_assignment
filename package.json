{
  "name": "bulk-email-sender",
  "version": "2.0.0",
  "type": "module",
  "description": "Web-based bulk email sender with user management and WYSIWYG editor",
  "main": "src/app.ts",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c green,cyan \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:backend": "bun run --watch src/app.ts",
    "dev:frontend": "vite --host 0.0.0.0",
    "build:frontend": "vite build && bun scripts/copy-frontend.mjs",
    "check:frontend": "svelte-check --tsconfig ./tsconfig.json",
    "build": "bun run build:frontend && bun build --target=bun --packages=external src/app.ts --outdir=dist",
    "start": "bun run src/app.ts",
    "clean": "rm -rf dist uploads/* logs/* data/users.db",
    "reset-db": "rm -f data/users.db data/scheduler.db",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "email",
    "bulk-email",
    "smtp",
    "nodemailer",
    "bun",
    "typescript",
    "authentication",
    "user-management"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "lucide-svelte": "^0.468.0",
    "quill": "^2.0.3",
    "hono": "^3.12.0",
    "nodemailer": "^6.9.8",
    "xlsx": "^0.18.5",
    "multer": "^1.4.5-lts.1",
    "csv-stringify": "^6.4.4",
    "dotenv": "^16.3.1",
    "argon2": "^0.31.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "concurrently": "^9.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "vite": "^6.0.0",
    "@types/nodemailer": "^6.4.14",
    "@types/multer": "^1.4.11",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
